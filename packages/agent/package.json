{
  "name": "microrun",
  "version": "0.1.0",
  "description": "microrun agent and deploy CLI",
  "license": "MIT",
  "author": "dmytro-rudenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmytro-rudenko/microrun.git",
    "directory": "packages/agent"
  },
  "homepage": "https://github.com/dmytro-rudenko/microrun#readme",
  "bugs": {
    "url": "https://github.com/dmytro-rudenko/microrun/issues"
  },
  "keywords": [
    "docker",
    "docker-compose",
    "deploy",
    "rollback",
    "release",
    "agent",
    "cli"
  ],
  "type": "module",
  "bin": {
    "microrun": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=26"
  },
  "exports": {
    "./handler": "./src/handler.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/lib-storage": "^3.1175.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@microrun/core": "workspace:*",
    "@types/ws": "^8.18.1",
    "tsup": "^9.0.0"
  }
}
