{
  "name": "@microrun/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "css": "tailwindcss -i src/public/app.src.css -o src/public/app.css --minify",
    "dev:css": "tailwindcss -i src/public/app.src.css -o src/public/app.css --watch",
    "build": "pnpm css && tsup",
    "postbuild": "node -e \"const fs=require('node:fs');fs.mkdirSync('dist/public',{recursive:true});fs.cpSync(require.resolve('htmx.org/dist/htmx.min.js'),'dist/public/htmx.min.js');fs.cpSync('src/public/app.css','dist/public/app.css')\"",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/lib-storage": "^3.1175.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.2",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.3.7",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "htmx.org": "^2.0.11",
    "knex": "^3.3.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@microrun/core": "workspace:*",
    "@tailwindcss/cli": "^4.3.5",
    "microrun": "workspace:*",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0"
  }
}
