{
  "name": "microrun-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": { "node": ">=26" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:docker": "vitest run -c vitest.docker.config.ts",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "verify": "pnpm -r build && pnpm test && pnpm test:docker && pnpm test:e2e",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
